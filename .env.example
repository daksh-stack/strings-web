# ---------------------------------------------------------------------------
# Environment variables — copy to `.env.local` and fill in. Never commit real
# credentials. All values below are names only; no secrets live in this repo.
# ---------------------------------------------------------------------------

# Public site URL, used for canonical links, Open Graph and the sitemap.
# Example: https://www.your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contact enquiry delivery ---------------------------------------------
# The provider the /api/contact route uses to deliver enquiries.
# Supported values:
#   webhook   POST the enquiry as JSON to ENQUIRY_WEBHOOK_URL (works with
#             Zapier, Make, Slack incoming webhooks, a CRM endpoint, …)
#   (unset)   Development mode: submissions are validated but NOT delivered,
#             and the form says so honestly instead of faking success.
ENQUIRY_PROVIDER=

# Required when ENQUIRY_PROVIDER=webhook.
ENQUIRY_WEBHOOK_URL=

# Optional bearer token sent with the webhook request.
ENQUIRY_WEBHOOK_TOKEN=

# Inbox that should receive enquiries (used by future email providers and
# shown in delivery logs; not exposed to the browser).
CONTACT_INBOX_EMAIL=
